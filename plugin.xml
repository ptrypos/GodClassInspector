<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

	<extension point="org.eclipse.ui.commands">
		<category
			id="godclassinspector.commands.category"
			name="God Class Analysis" />
		<command
			categoryId="godclassinspector.commands.category"
			name="Scan Project for God Classes"
			id="godclassinspector.commands.scanCommand">
		</command>
		<command
			categoryId="godclassinspector.commands.category"
			name="Analyze Project for God Classes"
			id="godclassinspector.commands.analyzeCommand">
		</command>
	</extension>

	<extension point="org.eclipse.ui.handlers">
		<handler
			class="godclassinspector.handlers.DiscoverHandler"
			commandId="godclassinspector.commands.scanCommand">
			<enabledWhen>
				<with variable="selection">
					<count value="1" />
					<iterate ifEmpty="false">
						<or>
							<instanceof
								value="org.eclipse.core.resources.IProject" />
							<instanceof
								value="org.eclipse.jdt.core.IJavaProject" />
						</or>
					</iterate>
				</with>
			</enabledWhen>
		</handler>

		<handler
			class="godclassinspector.handlers.AnalyzeHandler"
			commandId="godclassinspector.commands.analyzeCommand">
		</handler>
	</extension>

	<extension point="org.eclipse.ui.menus">

		<menuContribution
			locationURI="menu:org.eclipse.ui.main.menu?after=additions">
			<menu
				id="godclassinspector.menus.mainMenu"
				label="God Class Inspector">
				<command
					commandId="godclassinspector.commands.scanCommand"
					label="Scan Project"
					tooltip="Detect source files of the project">
					<visibleWhen checkEnabled="false" />
				</command>

				<command
					commandId="godclassinspector.commands.analyzeCommand"
					label="Analyze Project"
					tooltip="Detect god classes if exist">
					<visibleWhen checkEnabled="false" />
				</command>
			</menu>
		</menuContribution>

		<menuContribution
			allPopups="false"
			locationURI="popup:org.eclipse.ui.popup.any?after=additions">
			<menu
				id="godclassinspector.menus.contextMenu"
				label="God Class Inspector">
				<command
					commandId="godclassinspector.commands.scanCommand"
					label="Scan Project"
					tooltip="Detect source files of the project">
					<visibleWhen checkEnabled="true" />
				</command>
			</menu>
		</menuContribution>

	</extension>

	<extension point="org.eclipse.ui.views">
		<view
			class="godclassinspector.ui.FilesFoundUI"
			id="godclassinspector.ui.foundFiles"
			name="God Class Inspector Found Files">
		</view>
	</extension>

</plugin>